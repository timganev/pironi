#!/usr/bin/env sh
set -eu

PIRONI_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Only a launcher knows where its own bundle is. Pironi plants the skills carried in
# $PIRONI_DIR/skills into the store it reads, and --portable uses it to keep everything here.
PIRONI_BUNDLE_DIR="$PIRONI_DIR"
export PIRONI_BUNDLE_DIR

# Started from inside the bundle the working directory is the program's own folder, and an agent
# whose workspace is that folder will write into it. Anywhere else the directory the person stood
# in is the one they meant, which is how Pironi behaves when it is not a release.
if [ "$PWD" = "$PIRONI_DIR" ]; then
  PIRONI_DEFAULT_WORKSPACE="${PIRONI_DEFAULT_WORKSPACE:-$HOME}"
  export PIRONI_DEFAULT_WORKSPACE
fi

if [ ! -x "$PIRONI_DIR/runtime/bin/java" ]; then
  echo "Pironi runtime is missing: $PIRONI_DIR/runtime/bin/java" >&2
  exit 1
fi

exec "$PIRONI_DIR/runtime/bin/java" -jar "$PIRONI_DIR/pironi.jar" "$@"
